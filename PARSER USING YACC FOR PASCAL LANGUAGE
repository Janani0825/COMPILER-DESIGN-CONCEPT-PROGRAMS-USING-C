%{
#include "y.tab.h"
#include <stdlib.h>
%}

%%

"repeat"        { return REPEAT; }
"until"         { return UNTIL; }
"while"         { return WHILE; }
"do"            { return DO; }
"if"            { return IF; }
"then"          { return THEN; }
"else"          { return ELSE; }
"begin"         { return BEGIN_BLK; }
"end"           { return END_BLK; }

"or"            { return OR; }
"and"           { return AND; }
"not"           { return NOT; }
"div"           { return DIV; }
"mod"           { return MOD; }
"true"          { return TRUE_VAL; }
"false"         { return FALSE_VAL; }

":="            { return ASSIGN; }

"<>"            { return NE; }
"<="            { return LE; }
">="            { return GE; }
"="             { return EQ; }
"<"             { return LT; }
">"             { return GT; }

[0-9]+\.[0-9]+  { return REAL_CONST; }
[0-9]+          { return INT_CONST; }

[a-zA-Z_][a-zA-Z0-9_]*    { return ID; }

[ \t\n\r]+      ;

"+"             { return '+'; }
"-"             { return '-'; }
"*"             { return '*'; }
"/"             { return '/'; }
"^"             { return '^'; }
"("             { return '('; }
")"             { return ')'; }
";"             { return ';'; }

.               { return yytext[0]; }

%%

int yywrap()
{
    return 1;
}
