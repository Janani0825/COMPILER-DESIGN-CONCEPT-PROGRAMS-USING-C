%{
#include <stdio.h>
#include <stdlib.h>

int yylex(void);
void yyerror(const char *s);
%}

%token ID INT_CONST REAL_CONST

%token REPEAT UNTIL
%token WHILE DO
%token IF THEN ELSE
%token BEGIN_BLK END_BLK

%token OR AND NOT
%token DIV MOD

%token TRUE_VAL FALSE_VAL

%token ASSIGN

%token EQ NE LT GT LE GE

%left OR
%left AND

%left EQ NE LT GT LE GE

%left '+' '-'

%left '*' '/' DIV MOD

%right '^'

%right NOT UPLUS UMINUS

%nonassoc LOWER_THAN_ELSE
%nonassoc ELSE


%%



SL
    : S ';' SL
    | S ';'
    | S
    ;



S
    : A
    | R
    | W
    | I
    | B
    ;



A
    : ID ASSIGN E
    ;



R
    : REPEAT RSL UNTIL C
    ;


RSL
    : S ';' RSL
    | S ';'
    ;

W
    : WHILE C DO S
    ;


I
    : IF C THEN S %prec LOWER_THAN_ELSE
    | IF C THEN S ELSE S
    ;


B
    : BEGIN_BLK SL END_BLK
    ;


C
    : E relop E
    ;



relop
    : EQ
    | NE
    | LT
    | GT
    | LE
    | GE
    ;


E
    : E '+' E
    | E '-' E
    | E OR E
    | T
    ;

T
    : T '*' T
    | T '/' T
    | T DIV T
    | T MOD T
    | T AND T
    | P
    ;


P
    : F '^' P
    | F
    ;

F
    : '+' F %prec UPLUS
    | '-' F %prec UMINUS
    | NOT F
    | '(' E ')'
    | ID
    | INT_CONST
    | REAL_CONST
    | TRUE_VAL
    | FALSE_VAL
    ;


%%


void yyerror(const char *s)
{
    printf("\nSyntax Error: %s\n", s);
}


int main()
{
    printf("Enter the Pascal program:\n");

    if (yyparse() == 0)
        printf("\nValid Pascal Program\n");
    else
        printf("\nInvalid Pascal Program\n");

    return 0;
}
