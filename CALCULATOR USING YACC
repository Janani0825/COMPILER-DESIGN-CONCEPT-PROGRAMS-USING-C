%{
#include "y.tab.h"
#include <stdlib.h>
%}
%x BM
%%
[0-9]+\.[0-9]+    { BEGIN(BM); yylval.fval = atof(yytext); return FC; }
[0-9]+            { BEGIN(BM); yylval.ival = atoi(yytext); return IC; }
<BM>"+"           { BEGIN(0); return PLUS; }
<BM>"-"           { BEGIN(0); return MINUS; }
<BM>"*"           { BEGIN(0); return STAR; }
<BM>"/"           { BEGIN(0); return SLASH; }
<BM>"%"           { BEGIN(0); return MOD; }
<BM>"^"           { BEGIN(0); return POWER; }
"-"               { BEGIN(0); return UMINUS; }
<BM>"!"           { BEGIN(BM); return FACT; }
"("               { BEGIN(0); return OP; }
<BM>")"           { BEGIN(BM); return CP; }
"_"               { BEGIN(0); return FLO; }
<BM>"_"           { BEGIN(BM); return FLC; }
<BM>\n             { BEGIN(0); return NL; }
[ \t]+             { ; }
.                  { ; }
%%
int yywrap()
{
    return 1;
}
