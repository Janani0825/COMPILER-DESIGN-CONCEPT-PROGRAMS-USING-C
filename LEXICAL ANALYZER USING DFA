#include "dfa.h"
#include <string.h>

int main()
{
    dfa d;
    char sentence[500];

    printf("=====================================\n");
    printf("   LEXICAL ANALYSIS USING DFA\n");
    printf("=====================================\n");

    d = readDFA();

    printDFA(d);

    getchar();

    printf("\nEnter the sentence: ");
    fgets(sentence, sizeof(sentence), stdin);

    sentence[strcspn(sentence, "\n")] = '\0';

    lexerwithDFA(sentence, d);

    return 0;
}
