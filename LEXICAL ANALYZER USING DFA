#ifndef DFA_H
#define DFA_H

#include <stdio.h>

typedef struct dfa
{
    char sts[30];
    char syms[10];
    char tt[30][10];
    char ist;
    char fsts[10];
} dfa;

dfa readDFA(void);
void printDFA(dfa);
void lexerwithDFA(char *, dfa);

#endif
