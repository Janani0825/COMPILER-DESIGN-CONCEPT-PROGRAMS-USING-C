%{
#include "y.tab.h"
#include <string.h>
%}

%%

"if"                { return IF; }
"else"              { return ELSE; }
"while"             { return WHILE; }
"do"                { return DO; }

"=="|"!="|"<="|">="|"<"|">" {
    strcpy(yylval.name, yytext);
    return RELOP;
}

[0-9]+              { strcpy(yylval.name, yytext); return NUM; }
[a-zA-Z_][a-zA-Z0-9_]* {
    strcpy(yylval.name, yytext);
    return ID;
}

"="                 { return ASSIGN; }
"+"                 { return PLUS; }
"-"                 { return MINUS; }
"*"                 { return STAR; }
"/"                 { return DIV; }

"("                 { return LPAREN; }
")"                 { return RPAREN; }
"{"                 { return LBRACE; }
"}"                 { return RBRACE; }
";"                 { return SEMICOLON; }

[ \t\n]+            ;
.                   { return yytext[0]; }

%%
int yywrap(){
    return 1;
}
