#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <ctype.h>
#define MAX 200
#define SIZE 40
struct TAC
{
    char op[SIZE];
    char a[SIZE];
    char b[SIZE];
    char res[SIZE];
    int active;
};
struct TAC t[MAX];
int n = 0;
char outputs[MAX][SIZE];
int outputCount = 0;
void trim(char s[])
{
    int i = 0;
    int len = strlen(s);
    while (i < len && isspace((unsigned char)s[i]))
        i++;
    if (i > 0)
        memmove(s, s + i, strlen(s + i) + 1);
    len = strlen(s);
    while (len > 0 && isspace((unsigned char)s[len - 1]))
        s[--len] = '\0';
}
void readInput()
{
    FILE *fp;
    char line[200];
    char *p1, *p2, *p3;
    fp = fopen("input.txt", "r");
    if (fp == NULL)
    {
        printf("Cannot open input.txt\n");
        exit(1);
    }
    while (fgets(line, sizeof(line), fp) != NULL)
    {
        trim(line);
        if (line[0] == '\0')
            continue;
        p1 = strchr(line, ',');
        if (p1 == NULL)
            continue;
        p2 = strchr(p1 + 1, ',');
        if (p2 == NULL)
            continue;
        p3 = strchr(p2 + 1, ',');
        if (p3 == NULL)
            continue;
        if (n >= MAX)
            break;
        *p1 = '\0';
        *p2 = '\0';
        *p3 = '\0';
        strcpy(t[n].op, line);
        strcpy(t[n].a, p1 + 1);
        strcpy(t[n].b, p2 + 1);
        strcpy(t[n].res, p3 + 1);
        trim(t[n].op);
        trim(t[n].a);
        trim(t[n].b);
        trim(t[n].res);
        t[n].active = 1;
        n++;
    }
    fclose(fp);
}
void display(FILE *fp, char title[])
{
    int i;
    fprintf(fp, "\n--- %s ---\n", title);
    fprintf(fp, "%-10s %-10s %-10s %-10s\n",
            "Operator", "Arg1", "Arg2", "Result");
    for (i = 0; i < n; i++)
    {
        if (t[i].active)
        {
            fprintf(fp, "%-10s %-10s %-10s %-10s\n",
                    t[i].op,
                    t[i].a,
                    t[i].b[0] ? t[i].b : "-",
                    t[i].res);
        }
    }
}
int isNumber(char s[])
{
    char *end;
    if (s[0] == '\0')
        return 0;
    strtoll(s, &end, 10);
    return *end == '\0';
}
int isOperator(char op[])
{
    return strcmp(op, "+") == 0 ||
           strcmp(op, "-") == 0 ||
           strcmp(op, "*") == 0 ||
           strcmp(op, "/") == 0;
}

int usedInOriginal(char var[])
{
    int i;

    for (i = 0; i < n; i++)
    {
        if (strcmp(t[i].a, var) == 0 ||
            strcmp(t[i].b, var) == 0)
            return 1;
    }

    return 0;
}

/* Check whether an instruction is the last definition */
int isLastDefinition(int i)
{
    int j;

    for (j = i + 1; j < n; j++)
    {
        if (strcmp(t[j].res, t[i].res) == 0)
            return 0;
    }

    return 1;
}
void findOutputs()
{
    int i, j, found;

    for (i = 0; i < n; i++)
    {
        if (!isLastDefinition(i))
            continue;

        if (usedInOriginal(t[i].res))
            continue;

        found = 0;

        for (j = 0; j < outputCount; j++)
        {
            if (strcmp(outputs[j], t[i].res) == 0)
            {
                found = 1;
                break;
            }
        }

        if (!found && outputCount < MAX)
        {
            strcpy(outputs[outputCount], t[i].res);
            outputCount++;
        }
    }
}
int findDefinition(int i, char var[])
{
    int j;

    for (j = i - 1; j >= 0; j--)
    {
        if (t[j].active &&
            strcmp(t[j].res, var) == 0)
            return j;
    }

    return -1;
}
int constantFolding()
{
    int i, changed = 0;
    long long a, b, result;
    char value[SIZE];

    for (i = 0; i < n; i++)
    {
        if (!t[i].active || !isOperator(t[i].op))
            continue;

        if (!isNumber(t[i].a) || !isNumber(t[i].b))
            continue;

        a = atoll(t[i].a);
        b = atoll(t[i].b);

        if (strcmp(t[i].op, "+") == 0)
            result = a + b;
        else if (strcmp(t[i].op, "-") == 0)
            result = a - b;
        else if (strcmp(t[i].op, "*") == 0)
            result = a * b;
        else
        {
            if (b == 0)
                continue;

            result = a / b;
        }

        snprintf(value, sizeof(value), "%lld", result);

        strcpy(t[i].op, "=");
        strcpy(t[i].a, value);
        t[i].b[0] = '\0';

        changed = 1;
    }

    return changed;
}

/* 2. Constant Propagation */
int constantPropagation()
{
    int i, j, changed = 0;
    char value[SIZE];

    for (i = 0; i < n; i++)
    {
        if (!t[i].active)
            continue;

        if (t[i].a[0] && !isNumber(t[i].a))
        {
            j = findDefinition(i, t[i].a);

            if (j >= 0 &&
                strcmp(t[j].op, "=") == 0 &&
                t[j].b[0] == '\0' &&
                isNumber(t[j].a))
            {
                strcpy(value, t[j].a);
                strcpy(t[i].a, value);
                changed = 1;
            }
        }

        if (t[i].b[0] && !isNumber(t[i].b))
        {
            j = findDefinition(i, t[i].b);

            if (j >= 0 &&
                strcmp(t[j].op, "=") == 0 &&
                t[j].b[0] == '\0' &&
                isNumber(t[j].a))
            {
                strcpy(value, t[j].a);
                strcpy(t[i].b, value);
                changed = 1;
            }
        }
    }

    return changed;
}

int findCopy(int i, char var[], char source[])
{
    int j, k;

    j = findDefinition(i, var);

    if (j < 0)
        return 0;

    if (strcmp(t[j].op, "=") != 0 ||
        t[j].b[0] != '\0' ||
        isNumber(t[j].a) ||
        strcmp(t[j].a, var) == 0)
        return 0;

    strcpy(source, t[j].a);

    for (k = j + 1; k < i; k++)
    {
        if (t[k].active &&
            strcmp(t[k].res, source) == 0)
            return 0;
    }

    return 1;
}

/* 3. Copy Propagation */
int copyPropagation()
{
    int i, changed = 0;
    char source[SIZE];

    for (i = 0; i < n; i++)
    {
        if (!t[i].active)
            continue;

        if (t[i].a[0] &&
            !isNumber(t[i].a) &&
            findCopy(i, t[i].a, source))
        {
            strcpy(t[i].a, source);
            changed = 1;
        }

        if (t[i].b[0] &&
            !isNumber(t[i].b) &&
            findCopy(i, t[i].b, source))
        {
            strcpy(t[i].b, source);
            changed = 1;
        }
    }

    return changed;
}

/* 4. Common Subexpression Elimination */
int commonSubexpression()
{
    int i, j, k, valid;
    int changed = 0;

    for (i = 0; i < n; i++)
    {
        if (!t[i].active || !isOperator(t[i].op))
            continue;

        for (j = i - 1; j >= 0; j--)
        {
            if (!t[j].active)
                continue;

            if (strcmp(t[i].op, t[j].op) != 0 ||
                strcmp(t[i].a, t[j].a) != 0 ||
                strcmp(t[i].b, t[j].b) != 0)
                continue;

            valid = 1;

            for (k = j + 1; k < i; k++)
            {
                if (!t[k].active)
                    continue;

                if (strcmp(t[k].res, t[i].a) == 0 ||
                    strcmp(t[k].res, t[i].b) == 0 ||
                    strcmp(t[k].res, t[j].res) == 0)
                {
                    valid = 0;
                    break;
                }
            }

            if (valid)
            {
                strcpy(t[i].op, "=");
                strcpy(t[i].a, t[j].res);
                t[i].b[0] = '\0';

                changed = 1;
                break;
            }
        }
    }

    return changed;
}

/* Check whether a variable is one of the original outputs */
int isOutput(char var[])
{
    int i;

    for (i = 0; i < outputCount; i++)
    {
        if (strcmp(outputs[i], var) == 0)
            return 1;
    }

    return 0;
}

/* 5. Dead Code Elimination */
int deadCodeElimination()
{
    int live[MAX] = {0};
    int i, j, changed = 0;
    int again;
    for (i = 0; i < n; i++)
    {
        if (t[i].active &&
            isOutput(t[i].res) &&
            isLastDefinition(i))
        {
            live[i] = 1;
        }
    }
    do
    {
        again = 0;

        for (i = n - 1; i >= 0; i--)
        {
            if (!t[i].active || !live[i])
                continue;

            if (t[i].a[0] && !isNumber(t[i].a))
            {
                j = findDefinition(i, t[i].a);

                if (j >= 0 && !live[j])
                {
                    live[j] = 1;
                    again = 1;
                }
            }

            if (t[i].b[0] && !isNumber(t[i].b))
            {
                j = findDefinition(i, t[i].b);

                if (j >= 0 && !live[j])
                {
                    live[j] = 1;
                    again = 1;
                }
            }
        }

    } while (again);
    for (i = 0; i < n; i++)
    {
        if (t[i].active && !live[i])
        {
            t[i].active = 0;
            changed = 1;
        }
    }
    return changed;
}
int main()
{
    FILE *out;
    int changed, pass = 1;

    readInput();
    findOutputs();

    display(stdout, "INPUT TAC");

    do
    {
        changed = 0;

        printf("\n========== PASS %d ==========\n", pass++);

        if (constantFolding())
        {
            changed = 1;
            display(stdout, "CONSTANT FOLDING");
        }

        if (constantPropagation())
        {
            changed = 1;
            display(stdout, "CONSTANT PROPAGATION");
        }

        if (commonSubexpression())
        {
            changed = 1;
            display(stdout, "COMMON SUBEXPRESSION ELIMINATION");
        }

        if (copyPropagation())
        {
            changed = 1;
            display(stdout, "COPY PROPAGATION");
        }

        if (deadCodeElimination())
        {
            changed = 1;
            display(stdout, "DEAD CODE ELIMINATION");
        }

    } while (changed);

    printf("\nOptimization completed. No more changes.\n");

    out = fopen("output.txt", "w");

    if (out == NULL)
    {
        printf("Cannot create output.txt\n");
        return 1;
    }

    display(out, "FINAL OPTIMIZED TAC");
    fclose(out);

    printf("Final optimized TAC saved in output.txt\n");

    return 0;
}
